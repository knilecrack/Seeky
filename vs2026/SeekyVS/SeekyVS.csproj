<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10 host: VS 2026 ships ServiceHub.Host.Extensibility.amd64 hosts per TFM
         (net8.0-windows8.0 and net10.0-windows10.0.19041.0). We target VS 2026 only,
         so take the net10 host and C# 14. Note: there is no 18.x Extensibility SDK yet —
         17.14.x is the latest on nuget.org and is the supported line for VS 2026. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RootNamespace>SeekyVS</RootNamespace>
    <AssemblyName>SeekyVS</AssemblyName>
    <!-- VSIX identity version (flows via ExtensionAssemblyVersion into the manifest) —
         bump on every release so VS offers the update. -->
    <Version>1.6.0</Version>
    <!-- LibraryImport source-generated P/Invoke (FffNativeClient) requires unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The windows10.0.19041.0 TFM implicitly references the C#/WinRT projection
         (Microsoft.Windows.SDK.NET.dll, ~25 MB in the VSIX). We call no WinRT APIs — drop it. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
  </PropertyGroup>

  <!--
    NOTE: WPF/WinForms are deliberately NOT used. The out-of-proc extension host
    (ServiceHub.Host.Extensibility.x64) runs on plain Microsoft.NETCore.App and cannot resolve
    the WindowsDesktop shared framework (FileNotFoundException: System.Windows.Extensions at the
    first WPF type). The search UI window is a raw Win32 HWND + WebView2 Core — see
    SeekyModalWindowManager.cs. Only Microsoft.Web.WebView2.Core is referenced; the Wpf/WinForms
    assemblies from the package are not pulled in without UseWPF/UseWindowsForms.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Lifts the SDK's transitive MessagePack 2.5.198 (NU1902/NU1903 advisories) to 3.x.
         MessagePack.dll is suppressed from the VSIX — the runtime copy comes from VS's
         extension host — so this only affects the compile-time graph. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

  <!-- Remote UI XAML must be an embedded resource named <RootNamespace>.SeekyToolWindowContent.xaml -->
  <ItemGroup>
    <EmbeddedResource Include="SeekyToolWindowContent.xaml" />
    <Page Remove="SeekyToolWindowContent.xaml" />
  </ItemGroup>

  <!-- Ship the WebView2 UI next to the extension assembly -->
  <ItemGroup>
    <Content Include="WebUI\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the native fff search library next to the extension assembly -->
  <ItemGroup>
    <Content Include="Tools\fff_c.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Ship SeekyVS.pdb inside the VSIX for Debug builds. F5 deploys by unzipping the VSIX, and
    VSSDK defaults IncludeDebugSymbolsInVSIXContainer to false, so the deployed extension had no
    symbols: the debugger attached, reported "you are debugging a Release build", and could not
    bind breakpoints — even though the assembly really was Debug (DebuggableAttribute = 263,
    optimizations off). IncludeDebugSymbolsInLocalVSIXDeployment is already true by default, but
    it only covers VSSDK's own local-deploy path, which this project type does not use.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
  </PropertyGroup>

  <!--
    Do NOT set DeployExtension=true here. The Extensibility SDK deliberately defaults it to false
    (VSSDK's own default is true) because the VSSDK deploy path is the VS 17 mechanism and cannot
    deploy an out-of-proc VS 2026 extension: its GetExtensionsPath task resolves the legacy
    <hive>\Extensions root rather than the <hive>\VSExtensions root this SDK declares in
    ExtensionInstallationRoot, and its EnableExtension task (FailIfNotInstalled="true") only knows
    the legacy Extension Manager. Turning it on gives you a choice of two failures: deploy into a
    directory VS never reads, or — if the path is redirected to VSExtensions — error VSSDK1031,
    "Extension … could not be found", from EnableExtension. Both were measured on VS 18.9.
    Deployment for this project is the project system's job (the .slnx carries <Deploy Solution=
    "Debug|*" />), not VSSDK's.
  -->
</Project>
